{
  "name": "ts-model-checker-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Visual TLA+-style formal model checker in TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @ts-model-checker/playground dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
